	(gr_text "ACHTUNG!\nALLES TURISTEN UND NONTEKNISCHEN LOOKENSPEEPERS!\nDAS KOMPUTERMASCHINE IST NICHT FÜR DER GEFINGERPOKEN UND \nMITTENGRABEN! ODERWISE IST EASY TO SCHNAPPEN DER \nSPRINGENWERK, BLOWENFUSEN UND POPPENCORKEN MIT SPITZENSPARKEN. \nIST NICHT FÜR GEWERKEN BEI DUMMKOPFEN. DER RUBBERNECKEN \nSIGHTSEEREN KEEPEN DAS COTTONPICKEN HÄNDER IN DAS POCKETS MUSS.\nZO RELAXEN UND WATSCHEN DER BLINKENLICHTEN."
		(at 190.3011 109.8136 0)
		(layer "B.SilkS")
		(uuid "8a3dfb39-f0cf-4755-8315-e7c9c4136eae")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.25)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
